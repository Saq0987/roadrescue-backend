# ═══════════════════════════════════════
#  RoadRescue — Environment Variables
#  Fill in your values below
# ═══════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# ─── MySQL Database ───
# Change DB_PASSWORD to your actual MySQL password
# If you have no password set, leave it empty like: DB_PASSWORD=
DB_HOST= sql12.freesqldatabase.com
DB_PORT=3306
DB_USER=sql12820985
DB_PASSWORD=sabYDc3NP1
DB_NAME= sql12820985

# ─── JWT Secret ───
# This can be any long random string — do not share it
JWT_SECRET=roadrescue_jwt_super_secret_key_2025
JWT_EXPIRES_IN=7d

# ─── Email (Nodemailer) ───
# Use your Gmail. For MAIL_PASS use an App Password (not your real password)
# Go to: Google Account → Security → App Passwords to generate one
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=RoadRescue <no-reply@roadrescue.com>

# ─── Google Maps API ───
# Get your key from: https://console.cloud.google.com
GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ─── Frontend URL (for CORS) ───
CLIENT_URL=http://localhost:3000